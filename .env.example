# Telegram — заявки прилетают сюда мгновенно
# 1) Создайте бота через @BotFather, скопируйте токен
TELEGRAM_BOT_TOKEN=123456789:AA...
# 2) chat_id личного чата или группы менеджеров (можно узнать через @userinfobot)
TELEGRAM_CHAT_ID=123456789

# Публичный адрес сайта (для canonical, OG, sitemap)
NEXT_PUBLIC_SITE_URL=https://erklez.ru

# Яндекс.Метрика — номер счётчика (создайте на metrika.yandex.ru).
# Пока пусто — счётчик не подключается. Впишите номер, и аналитика заработает.
# Заведите цели с id: lead_submit, contact_telegram, contact_whatsapp, contact_phone.
NEXT_PUBLIC_YM_ID=
# Код подтверждения прав в Яндекс.Вебмастере (webmaster.yandex.ru) — вставьте значение из meta-тега.
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Sanity CMS — админка контента на /studio.
# Пока пусто — сайт берёт контент из файлов (папка content/).
# Заполните после создания проекта на sanity.io, и сайт начнёт брать контент из CMS.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-07-01
